# Supabase Configuration
# Get these values from your Supabase project settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Spoonacular API (for recipe suggestions)
# Get your free API key at: https://spoonacular.com/food-api
# Free tier: 150 requests/day
EXPO_PUBLIC_SPOONACULAR_API_KEY=your-spoonacular-api-key

# Optional: Additional API keys
# NUTRITIONIX_APP_ID=your-app-id
# NUTRITIONIX_API_KEY=your-api-key
