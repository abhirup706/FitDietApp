{
  "expo": {
    "name": "FitDiet",
    "slug": "fitdiet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6200EE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitdiet.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "FitDiet needs access to your health data to track your fitness progress and provide personalized recommendations.",
        "NSHealthUpdateUsageDescription": "FitDiet needs permission to write workout data to Health.",
        "NSCameraUsageDescription": "FitDiet needs camera access to scan food barcodes.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fitdiet.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6200EE"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitDiet to access your camera to scan food barcodes."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ce2f02b8-92fe-425c-add8-ffa35300254c"
      }
    },
    "owner": "abhirup706"
  }
}
